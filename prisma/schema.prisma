generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// enums

enum UserRole {
  DONOR
  REQUESTER
  HOSPITAL
  ADMIN
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequestStatus {
  OPEN
  FULFILLED
  CANCELLED
}

enum NotificationChannel {
  WEB
  MOBILE
  WHATSAPP
  EMAIL
}

model District {
  id        String   @id @default(uuid())
  name      String
  nameBn    String?
  createdAt DateTime @default(now())

  cities        City[]
  donors        Donor[]
  bloodRequests BloodRequest[]
}

model City {
  id         String   @id @default(uuid())
  districtId String
  name       String
  nameBn     String?
  createdAt  DateTime @default(now())

  district      District       @relation(fields: [districtId], references: [id], onDelete: Cascade)
  donors        Donor[]
  bloodRequests BloodRequest[]

  @@index([districtId])
}


// models
model User {
  id                  String   @id @default(uuid())
  phone               String   @unique
  password            String?
  name                String
  role                UserRole
  email               String?
  fcmToken            String?
  webPushSubscription Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  donor                    Donor?
  hospital                 Hospital?
  bloodRequestsAsRequester BloodRequest[] @relation("RequestCreator")
  notifications            Notification[]
  messages                 Message[]
  refreshTokens            RefreshToken[]

  chatsAsParticipant1 Chat[] @relation("ChatParticipant1")
  chatsAsParticipant2 Chat[] @relation("ChatParticipant2")

  @@index([role])
}

model Donor {
  id               String     @id @default(uuid())
  userId           String     @unique
  bloodGroup       BloodGroup
  districtId       String
  cityId           String?
  lastDonationDate DateTime?
  canDonateAfter   DateTime?
  isAvailable      Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  district District @relation(fields: [districtId], references: [id])
  city     City?    @relation(fields: [cityId], references: [id])

  @@index([bloodGroup])
  @@index([districtId])
  @@index([isAvailable])
}

model Hospital {
  id            String   @id @default(uuid())
  userId        String   @unique
  hospitalName  String
  address       String?
  contactPerson String
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodStocks BloodStock[]

  @@index([verified])
}

model BloodRequest {
  id           String        @id @default(uuid())
  requesterId  String
  bloodGroup   BloodGroup
  quantity     Int           @default(1)
  urgency      Urgency       @default(MEDIUM)
  location     String?
  hospitalName String?
  contactPhone String?
  status       RequestStatus @default(OPEN)
  districtId   String?
  cityId       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  requester     User           @relation("RequestCreator", fields: [requesterId], references: [id], onDelete: Cascade)
  district      District?      @relation(fields: [districtId], references: [id])
  city          City?          @relation(fields: [cityId], references: [id])
  notifications Notification[]
  chats         Chat[]

  @@index([bloodGroup])
  @@index([status])
  @@index([requesterId])
  @@index([districtId])
}

model BloodStock {
  id          String     @id @default(uuid())
  hospitalId  String
  bloodGroup  BloodGroup
  quantity    Int        @default(0)
  unit        String     @default("bag")
  lastUpdated DateTime   @default(now())
  createdAt   DateTime   @default(now())

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, bloodGroup])
  @@index([bloodGroup])
  @@index([hospitalId])
}

model Notification {
  id             String              @id @default(uuid())
  userId         String
  bloodRequestId String
  channel        NotificationChannel
  title          String?
  body           String?
  read           Boolean             @default(false)
  readAt         DateTime?
  createdAt      DateTime            @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodRequest BloodRequest @relation(fields: [bloodRequestId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bloodRequestId])
}

model Chat {
  id             String   @id @default(uuid())
  bloodRequestId String?
  participant1Id String
  participant2Id String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bloodRequest BloodRequest? @relation(fields: [bloodRequestId], references: [id], onDelete: SetNull)
  participant1 User          @relation("ChatParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2 User          @relation("ChatParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([participant1Id])
  @@index([participant2Id])
  @@index([bloodRequestId])
}

model Message {
  id        String    @id @default(uuid())
  chatId    String
  senderId  String
  content   String
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([senderId])
}

model OtpVerification {
  id        String   @id @default(uuid())
  phone     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
